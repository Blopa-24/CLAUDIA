        "sets_type": {
          "name": "sets_type",
          "value": "\"sets\".\"type\" IN ('warmup', 'working', 'dropset', 'failure', 'amrap')"
        },
        "sets_entered_unit": {
          "name": "sets_entered_unit",
          "value": "\"sets\".\"entered_unit\" IS NULL OR \"sets\".\"entered_unit\" IN ('kg', 'lb')"
        },
        "sets_weight": {
          "name": "sets_weight",
          "value": "\"sets\".\"weight_kg\" IS NULL OR (\"sets\".\"weight_kg\" >= 0 AND \"sets\".\"weight_kg\" <= 1500)"
        },
        "sets_reps": {
          "name": "sets_reps",
          "value": "\"sets\".\"reps\" IS NULL OR \"sets\".\"reps\" >= 0"
        },
        "sets_rir": {
          "name": "sets_rir",
          "value": "\"sets\".\"rir\" IS NULL OR (\"sets\".\"rir\" >= 0 AND \"sets\".\"rir\" <= 10)"
        },
        "sets_rpe": {
          "name": "sets_rpe",
          "value": "\"sets\".\"rpe\" IS NULL OR (\"sets\".\"rpe\" >= 1 AND \"sets\".\"rpe\" <= 10 AND \"sets\".\"rpe\" * 2 = CAST(\"sets\".\"rpe\" * 2 AS INTEGER))"
        },
        "sets_duration": {
          "name": "sets_duration",
          "value": "\"sets\".\"duration_s\" IS NULL OR \"sets\".\"duration_s\" >= 0"
        },
        "sets_distance": {
